# Copia este archivo a .env y rellena los valores reales.
# NUNCA subas .env (ya está en .gitignore).

# --- Base de datos (PostgreSQL) ---
# Local: postgresql://usuario:password@localhost:5432/evalia?schema=public
# Hosted recomendado: Neon (via Vercel Marketplace) — cualquier Postgres funciona.
DATABASE_URL="postgresql://usuario:password@localhost:5432/evalia?schema=public"

# --- Autenticación (Auth.js) ---
# Genera uno con: npx auth secret
AUTH_SECRET=""
# URL base de la app (http://localhost:3000 en desarrollo)
AUTH_URL="http://localhost:3000"

# --- IA (proveedores gratuitos, sin tarjeta) ---
# Generación: Groq (groq.com/keys) — rápido, buenos límites gratis diarios.
GROQ_API_KEY=""
# Validación / fallback: Google AI Studio (aistudio.google.com/apikey) — Gemini gratis, sin tarjeta.
GOOGLE_GENERATIVE_AI_API_KEY=""

# --- Almacenamiento de documentos (Vercel Blob) ---
BLOB_READ_WRITE_TOKEN=""

# --- Rate limiting / cuotas (Upstash Redis, vía integración "Upstash for Redis" del Marketplace de Vercel) ---
# Si provisionas Upstash directamente (no vía Vercel), usa UPSTASH_REDIS_REST_URL / _TOKEN en su lugar.
KV_REST_API_URL=""
KV_REST_API_TOKEN=""

# --- Email transaccional (recuperación de contraseña, notificaciones) ---
RESEND_API_KEY=""
EMAIL_FROM="Evalia <no-reply@tudominio.com>"
